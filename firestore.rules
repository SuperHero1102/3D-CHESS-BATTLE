rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'avatarHue', 'elo',
          'wins', 'losses', 'draws', 'gamesPlayed',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'avatarHue', 'elo',
          'wins', 'losses', 'draws', 'gamesPlayed',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.avatarHue is int && data.avatarHue >= 0 && data.avatarHue <= 360
        && data.elo is int && data.elo >= 100 && data.elo <= 4000
        && data.wins is int && data.wins >= 0 && data.wins <= 100000
        && data.losses is int && data.losses >= 0 && data.losses <= 100000
        && data.draws is int && data.draws >= 0 && data.draws <= 100000
        && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 300000
        && data.gamesPlayed == data.wins + data.losses + data.draws
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'preferredSide', 'preferredLang', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'preferredSide', 'preferredLang', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.email is string && data.email.size() <= 128
        && data.preferredSide in ['w', 'b', 'random']
        && data.preferredLang in ['vi', 'en']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll([
          'matchId', 'ownerUid', 'mode', 'opponentName', 'playerColor',
          'result', 'reason', 'movesCount', 'eloChange', 'durationSec',
          'pgnSummary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'matchId', 'ownerUid', 'mode', 'opponentName', 'playerColor',
          'result', 'reason', 'movesCount', 'eloChange', 'durationSec',
          'pgnSummary', 'createdAt'
        ])
        && isValidId(data.matchId)
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.mode in ['ai', 'local', 'online']
        && data.opponentName is string && data.opponentName.size() >= 1 && data.opponentName.size() <= 48
        && data.playerColor in ['w', 'b']
        && data.result in ['win', 'loss', 'draw']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 40
        && data.movesCount is int && data.movesCount >= 0 && data.movesCount <= 1000
        && data.eloChange is int && data.eloChange >= -64 && data.eloChange <= 64
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 86400
        && data.pgnSummary is string && data.pgnSummary.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidSafetyReport(data) {
      return data.keys().hasAll(['reportId', 'reporterUid', 'roomCode', 'reason', 'createdAt'])
        && data.keys().hasOnly(['reportId', 'reporterUid', 'roomCode', 'reason', 'createdAt'])
        && isValidId(data.reportId)
        && isValidId(data.reporterUid)
        && data.reporterUid == request.auth.uid
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 120
        && data.createdAt is timestamp;
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.elo is int && resource.data.gamesPlayed is int;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == userId
        && incoming().elo == 1200
        && incoming().wins == 0
        && incoming().losses == 0
        && incoming().draws == 0
        && incoming().gamesPlayed == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarHue', 'updatedAt'])
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['elo', 'wins', 'losses', 'draws', 'gamesPlayed', 'updatedAt'])
            && incoming().gamesPlayed == existing().gamesPlayed + 1
            && incoming().elo >= existing().elo - 64
            && incoming().elo <= existing().elo + 64
            && (
              (incoming().wins == existing().wins + 1 && incoming().losses == existing().losses && incoming().draws == existing().draws) ||
              (incoming().losses == existing().losses + 1 && incoming().wins == existing().wins && incoming().draws == existing().draws) ||
              (incoming().draws == existing().draws + 1 && incoming().wins == existing().wins && incoming().losses == existing().losses)
            )
          )
        );

      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'preferredSide', 'preferredLang', 'updatedAt']);

      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && existing().ownerUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(matchId)
        && isValidMatchRecord(incoming())
        && incoming().matchId == matchId
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if false;

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidSafetyReport(incoming())
        && incoming().reportId == reportId
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
